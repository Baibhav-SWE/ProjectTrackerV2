# Copy to .env and replace placeholders with your real values.
# ( .env is gitignored — never commit secrets. )

# MongoDB: the app uses the path segment after the host as the database name.
# In the example below, that name is "project_tracker" (required — do not leave it blank).
#
# Atlas-style (MongoDB Atlas):
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/project_tracker?retryWrites=true&w=majority
#
# Local MongoDB (uncomment and adjust if you run Mongo locally):
# MONGODB_URI=mongodb://127.0.0.1:27017/project_tracker

# Optional: database on the SAME cluster for Compare tab collections `pre_data` / `post_data`.
# If omitted, the app tries the URI database first, then auto-detects `AWI_users` when the URI DB is empty.
# To force a database explicitly:
# MONGODB_COMPARE_DB=AWI_users
